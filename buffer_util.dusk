/*
Usage:

```dusk
import gltf "gltf2"

buf := gltf.buffer_slice(data, accessor_index).([][3]f32)
for val, i in buf {
    // ...
}
```

Alternatively you can use a switch statement to handle multiple data formats:

```dusk
buf := gltf.buffer_slice(data, accessor_index)
#partial switch vals in buf {
case [][4]u8:
    for val, i in vals { 
        // ...
    }
case [][4]i16:
    for val, i in vals {
        // ...
    }
}
```                           
*/
import "core:os"
import "core:math/mat2"
import "core:math/mat3"
import "core:math/mat4"


// All accessor type and component type combinations
Buffer_Slice :: union {
    []u8,
    []i8,
    []i16,
    []u16,
    []u32,
    []f32,
    [][2]u8,
    [][2]i8,
    [][2]i16,
    [][2]u16,
    [][2]u32,
    [][2]f32,
    [][3]u8,
    [][3]i8,
    [][3]i16,
    [][3]u16,
    [][3]u32,
    [][3]f32,
    [][4]u8,
    [][4]i8,
    [][4]i16,
    [][4]u16,
    [][4]u32,
    [][4]f32,
    []mat2.Mat2(u8),
    []mat2.Mat2(i8),
    []mat2.Mat2(i16),
    []mat2.Mat2(u16),
    []mat2.Mat2(u32),
    []mat2.Mat2(f32),
    []mat3.Mat3(u8),
    []mat3.Mat3(i8),
    []mat3.Mat3(i16),
    []mat3.Mat3(u16),
    []mat3.Mat3(u32),
    []mat3.Mat3(f32),
    []mat4.Mat4(u8),
    []mat4.Mat4(i8),
    []mat4.Mat4(i16),
    []mat4.Mat4(u16),
    []mat4.Mat4(u32),
    []mat4.Mat4(f32),
}

buffer_slice :: proc(data: ^Data, accessor_index: Unsigned_Integer) -> Buffer_Slice {
    accessor := data.accessors[accessor_index]
    os.assert(accessor.buffer_view != nil, "buf_iter_make: selected accessor doesn't have buffer_view")

    buffer_view := data.buffer_views[accessor.buffer_view.(Unsigned_Integer) or_else {}]

    if _, ok := accessor.sparse.(Accessor_Sparse); ok {
        os.assert(false, "Sparse not supported")
        return nil
    }

    // if _, ok := buffer_view.byte_stride.(Unsigned_Integer); ok {  // eu inverti essa condicional.
    //     os.printfln("buffer_view: %", buffer_view)
    //     os.assert(false, "Cannot use a stride")
    //     return nil
    // }

    start_byte := accessor.byte_offset + buffer_view.byte_offset
    uri := data.buffers[buffer_view.buffer].uri

    switch v in uri {
    case string:
        os.assert(false, "URI is string")
        return nil
    case []u8:
        start_ptr: rawptr = &v[start_byte]
        switch accessor.type {
        case .Scalar:
            switch accessor.component_type {
            case .Unsigned_Byte:
                return (transmute([^]u8)start_ptr)[:accessor.count]
            case .Byte:
                return (transmute([^]i8)start_ptr)[:accessor.count]
            case .Short:
                return (transmute([^]i16)start_ptr)[:accessor.count]
            case .Unsigned_Short:
                return (transmute([^]u16)start_ptr)[:accessor.count]
            case .Unsigned_Int:
                return (transmute([^]u32)start_ptr)[:accessor.count]
            case .Float:
                return (transmute([^]f32)start_ptr)[:accessor.count]
            }

        case .Vector2:
            switch accessor.component_type {
            case .Unsigned_Byte:
                return (transmute([^][2]u8)start_ptr)[:accessor.count]
            case .Byte:
                return (transmute([^][2]i8)start_ptr)[:accessor.count]
            case .Short:
                return (transmute([^][2]i16)start_ptr)[:accessor.count]
            case .Unsigned_Short:
                return (transmute([^][2]u16)start_ptr)[:accessor.count]
            case .Unsigned_Int:
                return (transmute([^][2]u32)start_ptr)[:accessor.count]
            case .Float:
                return (transmute([^][2]f32)start_ptr)[:accessor.count]
            }

        case .Vector3:
            switch accessor.component_type {
            case .Unsigned_Byte:
                return (transmute([^][3]u8)start_ptr)[:accessor.count]
            case .Byte:
                return (transmute([^][3]i8)start_ptr)[:accessor.count]
            case .Short:
                return (transmute([^][3]i16)start_ptr)[:accessor.count]
            case .Unsigned_Short:
                return (transmute([^][3]u16)start_ptr)[:accessor.count]
            case .Unsigned_Int:
                return (transmute([^][3]u32)start_ptr)[:accessor.count]
            case .Float:
                return (transmute([^][3]f32)start_ptr)[:accessor.count]
            }

        case .Vector4:
            switch accessor.component_type {
            case .Unsigned_Byte:
                return (transmute([^][4]u8)start_ptr)[:accessor.count]
            case .Byte:
                return (transmute([^][4]i8)start_ptr)[:accessor.count]
            case .Short:
                return (transmute([^][4]i16)start_ptr)[:accessor.count]
            case .Unsigned_Short:
                return (transmute([^][4]u16)start_ptr)[:accessor.count]
            case .Unsigned_Int:
                return (transmute([^][4]u32)start_ptr)[:accessor.count]
            case .Float:
                return (transmute([^][4]f32)start_ptr)[:accessor.count]
            }

        case .Matrix2:
            switch accessor.component_type {
            case .Unsigned_Byte:
                return (transmute([^]mat2.Mat2(u8))start_ptr)[:accessor.count]
            case .Byte:
                return (transmute([^]mat2.Mat2(i8))start_ptr)[:accessor.count]
            case .Short:
                return (transmute([^]mat2.Mat2(i16))start_ptr)[:accessor.count]
            case .Unsigned_Short:
                return (transmute([^]mat2.Mat2(u16))start_ptr)[:accessor.count]
            case .Unsigned_Int:
                return (transmute([^]mat2.Mat2(u32))start_ptr)[:accessor.count]
            case .Float:
                return (transmute([^]mat2.Mat2(f32))start_ptr)[:accessor.count]
            }

        case .Matrix3:
            switch accessor.component_type {
            case .Unsigned_Byte:
                return (transmute([^]mat3.Mat3(u8))start_ptr)[:accessor.count]
            case .Byte:
                return (transmute([^]mat3.Mat3(i8))start_ptr)[:accessor.count]
            case .Short:
                return (transmute([^]mat3.Mat3(i16))start_ptr)[:accessor.count]
            case .Unsigned_Short:
                return (transmute([^]mat3.Mat3(u16))start_ptr)[:accessor.count]
            case .Unsigned_Int:
                return (transmute([^]mat3.Mat3(u32))start_ptr)[:accessor.count]
            case .Float:
                return (transmute([^]mat3.Mat3(f32))start_ptr)[:accessor.count]
            }

        case .Matrix4:
            switch accessor.component_type {
            case .Unsigned_Byte:
                return (transmute([^]mat4.Mat4(u8))start_ptr)[:accessor.count]
            case .Byte:
                return (transmute([^]mat4.Mat4(i8))start_ptr)[:accessor.count]
            case .Short:
                return (transmute([^]mat4.Mat4(i16))start_ptr)[:accessor.count]
            case .Unsigned_Short:
                return (transmute([^]mat4.Mat4(u16))start_ptr)[:accessor.count]
            case .Unsigned_Int:
                return (transmute([^]mat4.Mat4(u32))start_ptr)[:accessor.count]
            case .Float:
                return (transmute([^]mat4.Mat4(f32))start_ptr)[:accessor.count]
            }

        }
    }

    return nil
}
